@prefix enpkg:   <https://w3id.org/enpkg#> .
@prefix emi:     <https://w3id.org/emi#> .
@prefix ms:      <http://purl.obolibrary.org/obo/MS_> .
@prefix chemrof: <https://w3id.org/chemrof/> .
@prefix chebi:   <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix vs:      <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

#################################################################
# ENPKG Vocabulary
#
# Terms minted for the ENPKG knowledge-graph pipeline where no term in a reused
# vocabulary (EMI, PSI-MS, ChEBI/ChemROF) fits. Every knowledge graph the pipeline
# generates, for any user's project, uses these definitions, so this file (not the
# serializer that emits triples against it) is the source of truth for what an
# enpkg: term means. docs/VOCABULARY.md explains the mint-or-reuse policy.
#
# Every term carries exactly one vs:term_status:
#   unstable  declared, not emitted by the serializer; the definition may change
#   testing   emitted by the serializer; the definition may still change before the
#             first published release
#   stable    emitted, and the definition will not change; a change needs a new term
#   archaic   retired, kept so older graphs stay interpretable; not emitted
# enpkg/tests/test_data/test_vocabulary_drift.py checks the statuses against what
# the serializer emits, and that nothing is emitted that is not declared here.
#################################################################

<https://w3id.org/enpkg> a owl:Ontology ;
    owl:imports <https://w3id.org/emi> ;
    owl:versionInfo "0.3.0" ;
    dcterms:title "ENPKG Vocabulary" ;
    dcterms:description "Terms minted for the ENPKG knowledge-graph pipeline, reused unchanged across every knowledge graph the pipeline generates. Complements the Earth Metabolome Ontology (EMI), which this ontology imports." ;
    dcterms:creator "Loïc Le Grégam" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> .

vs:term_status a owl:AnnotationProperty ;
    rdfs:label "term status" ;
    rdfs:comment "The status of a vocabulary term, expressed as a short symbolic string; known values include 'unstable', 'testing', 'stable' and 'archaic'." ;
    rdfs:isDefinedBy <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

#################################################################
# Classes
#################################################################

### Annotations

enpkg:AdductAnnotation a owl:Class ;
    rdfs:subClassOf emi:StructuralAnnotation ;
    rdfs:label "adduct annotation" ;
    rdfs:comment "An MS1 hypothesis on one LCMS feature: one LOTUS molecular-formula group combined with one adduct recipe whose theoretical m/z explains the feature's precursor. Its candidate structures, linked by enpkg:hasCandidateStructure, share a molecular formula and are mass coincidences, not identifications; enpkg:annotationMethod records how the hypothesis was produced." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:SpectralAnnotation a owl:Class ;
    rdfs:subClassOf emi:StructuralAnnotation ;
    rdfs:label "spectral library annotation" ;
    rdfs:comment "An MS2 spectral-library match on one LCMS feature: the feature's fragmentation spectrum matched a library spectrum of a known structure. The structure is linked at the 2D-InChIKey level with emi:hasChemicalStructure, since a fragmentation match does not resolve stereochemistry; the match score is emi:hasSpectralScore." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:SiriusAnnotation a owl:Class ;
    rdfs:subClassOf emi:StructuralAnnotation ;
    rdfs:label "SIRIUS structure annotation" ;
    rdfs:comment "One ranked candidate structure that SIRIUS proposed for one LCMS feature from its fragmentation spectrum. The structure is linked at the 2D-InChIKey level with emi:hasChemicalStructure; SIRIUS's own rank is enpkg:annotationRank." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Adduct / MS1

enpkg:AdductRecipe a owl:Class ;
    rdfs:label "adduct recipe" ;
    rdfs:comment "The ionization form that turns a neutral molecule into an observed ion, such as [M+H]+ or [2M+Na]+: a multimer factor, signed ingredient counts, a charge magnitude and a polarity. One node per distinct recipe, shared by every annotation that applies it. Cf. MS:1003055 (adduct), which has no structured composition." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:Ingredient a owl:Class ;
    rdfs:label "adduct recipe ingredient" ;
    rdfs:comment "One named component of an adduct recipe with its signed count, such as proton +1 or water -1." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:AdductCluster a owl:Class ;
    rdfs:label "adduct cluster" ;
    skos:closeMatch emi:FBMNComponent ;
    rdfs:comment "The LCMS features that the MS1 adduct-relationship graph resolves as ionization forms of one molecule: an anchor (the base ion, [M+H]+ or [M-H]-) and its satellite adducts. emi:FBMNComponent is the corresponding grouping in the molecular network, by spectral similarity rather than by mass relationships." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:MolecularFormula a owl:Class ;
    rdfs:label "molecular formula" ;
    skos:exactMatch ms:1000866 ;
    rdfs:comment "A molecule's element composition and net charge, as a node shared by every structure and MS1 hypothesis with that formula. MS:1000866 is a PSI-MS value term rather than a class for typing nodes; this class is its node-typing counterpart." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:Atom a owl:Class ;
    rdfs:label "atom" ;
    skos:closeMatch chebi:33250 ;
    rdfs:comment "One element of a molecular formula with the number of its atoms the formula contains, such as C x 15 in C15H20O6." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Sample & spine

enpkg:SampleMetadata a owl:Class ;
    rdfs:label "sample metadata" ;
    rdfs:comment "Collection-level metadata about a sample, sourced from one row of the user's metadata file. One node per sample_id (emi-res:samplemetadata/<sample_id>), linked from that sample's emi:ExtractSample by enpkg:hasSampleMetadata. Distinct from ExtractSample, which is the analytical-process side." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:ExtraMetadata a owl:Class ;
    rdfs:label "extra sample metadata" ;
    rdfs:comment "The columns of one sample's metadata row that have no dedicated enpkg: term, as attributes of a single node (emi-res:samplemetadata/<sample_id>/extra) linked from that sample's SampleMetadata by enpkg:hasExtraMetadata. The attributes' predicates are minted from the column headers and are not enpkg: terms — see enpkg:extraMetadataField. Not emitted for a sample whose extra columns are all empty." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

#################################################################
# Object properties
#################################################################

### Sample & spine

enpkg:hasLabProcess a owl:ObjectProperty ;
    rdfs:label "has lab process" ;
    rdfs:domain emi:ExtractSample ;
    rdfs:range emi:LCMSAnalysis ;
    rdfs:comment "Links a sample to an analytical process performed on it. The edge reads from the sample toward the analysis that used it, matching EMI's framing that an analysis uses a sample." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasSampleMetadata a owl:ObjectProperty ;
    rdfs:label "has sample metadata" ;
    rdfs:domain emi:ExtractSample ;
    rdfs:range enpkg:SampleMetadata ;
    rdfs:comment "ExtractSample -> its collection-level SampleMetadata. Both nodes are keyed on sample_id, so the pos and neg runs of one sample share them." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasExtraMetadata a owl:ObjectProperty ;
    rdfs:label "has extra metadata" ;
    rdfs:domain enpkg:SampleMetadata ;
    rdfs:range enpkg:ExtraMetadata ;
    rdfs:comment "SampleMetadata -> the node carrying its user-defined columns." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasOTTMatch a owl:ObjectProperty ;
    rdfs:label "has Open Tree of Life match" ;
    rdfs:domain emi:LCMSAnalysis ;
    rdfs:range emi:Taxon ;
    rdfs:comment "Links an analysis to one Open Tree of Life (OTT) name-resolution result for its sample's source taxon. The result node is typed emi:Taxon and carries the match-quality properties (enpkg:matchScore, enpkg:isApproximateMatch, enpkg:isSynonym, enpkg:nomenclatureCode, enpkg:searchString); it is a different node from the organism the sample and its compounds point to." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Adduct / MS1

enpkg:hasRecipe a owl:ObjectProperty ;
    rdfs:label "has adduct recipe" ;
    rdfs:domain enpkg:AdductAnnotation ;
    rdfs:range enpkg:AdductRecipe ;
    rdfs:comment "Links an MS1 adduct annotation to the adduct recipe it applies." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasIngredient a owl:ObjectProperty ;
    rdfs:label "has ingredient" ;
    rdfs:domain enpkg:AdductRecipe ;
    rdfs:range enpkg:Ingredient ;
    rdfs:comment "Links an adduct recipe to one of its ingredients." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasAdductCluster a owl:ObjectProperty ;
    rdfs:label "has adduct cluster" ;
    rdfs:domain emi:LCMSFeatureSet ;
    rdfs:range enpkg:AdductCluster ;
    rdfs:comment "Links a feature set to an adduct cluster formed by some of its features." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasAnchor a owl:ObjectProperty ;
    rdfs:label "has anchor" ;
    rdfs:domain enpkg:AdductCluster ;
    rdfs:range emi:LCMSFeature ;
    rdfs:comment "Links an adduct cluster to its anchor feature, the base ion ([M+H]+ or [M-H]-). The anchor is also linked by enpkg:hasClusterMember." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasClusterMember a owl:ObjectProperty ;
    rdfs:label "has cluster member" ;
    rdfs:domain enpkg:AdductCluster ;
    rdfs:range emi:LCMSFeature ;
    rdfs:comment "Links an adduct cluster to each of its member features, anchor included." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:inAdductCluster a owl:ObjectProperty ;
    rdfs:label "in adduct cluster" ;
    rdfs:domain emi:LCMSFeature ;
    rdfs:range enpkg:AdductCluster ;
    owl:inverseOf enpkg:hasClusterMember ;
    rdfs:comment "Links a feature to the adduct cluster it belongs to; emitted for every member, anchor or satellite." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasCandidateStructure a owl:ObjectProperty ;
    rdfs:label "has candidate structure" ;
    rdfs:domain enpkg:AdductAnnotation ;
    rdfs:range emi:ChemicalStructure ;
    rdfs:comment "Links an MS1 adduct annotation to a structure whose mass fits it: a mass-coincidence candidate from a molecular-formula lookup, not an identification. A sibling of emi:hasChemicalStructure, which MS2 and SIRIUS annotations use for identifications, and not a subproperty of it, so that querying emi:hasChemicalStructure never returns mass-only candidates." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasMolecularFormula a owl:ObjectProperty ;
    rdfs:label "has molecular formula" ;
    rdfs:range enpkg:MolecularFormula ;
    rdfs:comment "Links a chemical structure, or an MS1 adduct annotation, to its molecular formula node. It declares no rdfs:domain, so using it entails nothing about the class of its subject." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasAtom a owl:ObjectProperty ;
    rdfs:label "has atom" ;
    rdfs:domain enpkg:MolecularFormula ;
    rdfs:range enpkg:Atom ;
    rdfs:comment "Links a molecular formula to one of its elements with its count. ChEBI and PSI-MS have no instance-level property for this; the nearest, obo:BFO_0000051 (has part), is used in ChEBI only as a class-level restriction without counts." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasCorrespondingAdduct a owl:ObjectProperty ;
    rdfs:label "corresponding MS1 adduct hypothesis" ;
    rdfs:domain enpkg:SpectralAnnotation ;
    rdfs:range enpkg:AdductAnnotation ;
    rdfs:comment "Links an MS2 spectral annotation to an MS1 adduct hypothesis that explains how the fragmentation-identified molecule ionised to this feature's precursor m/z, i.e. one whose molecular formula is the molecule's. When the molecule is in LOTUS it is among the hypothesis's candidate structures (shared 2D InChIKey); when only the spectral library knows it, the candidates are LOTUS isomers of the same formula. Asserted only from MS2 matches whose spectral score reaches the serializer's coupling threshold (ms2_coupling_min_score), so its absence does not mean no hypothesis corresponds." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Molecular network

enpkg:hasNetworkComponent a owl:ObjectProperty ;
    rdfs:label "has molecular-network component" ;
    rdfs:domain emi:LCMSFeatureSet ;
    rdfs:range emi:FBMNComponent ;
    rdfs:comment "Links a feature set to a connected component of its molecular network. The feature-set counterpart of emi:hasFBMNComponent, whose rdfs:domain is emi:LCMSFeature." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:hasComponentMember a owl:ObjectProperty ;
    rdfs:label "has network-component member" ;
    rdfs:domain emi:FBMNComponent ;
    rdfs:range emi:LCMSFeature ;
    owl:inverseOf emi:hasFBMNComponent ;
    rdfs:comment "Links a molecular-network component to each of its member features." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Ions

enpkg:hasIon a owl:ObjectProperty ;
    rdfs:label "has ion" ;
    rdfs:domain emi:LCMSFeature ;
    rdfs:range chebi:24870 ;
    rdfs:comment "Links a feature to one product ion of its MS2 spectrum. The ion node carries no rdf:type of its own (PSI-MS's product-ion term, MS:1000342, is obsolete with no replacement); the range entails that it is a ChEBI ion. Emitted only when the serializer is asked to include ions." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

#################################################################
# Datatype properties
#################################################################

### Sample & spine
# Reused rather than minted: emi:hasRowId (feature id), dcterms:identifier (sample id,
# OTT taxon id).

enpkg:sourceId a owl:DatatypeProperty ;
    rdfs:label "source identifier" ;
    rdfs:domain emi:ExtractSample ; rdfs:range xsd:string ;
    rdfs:comment "Identifier of the source material the sample was taken from, from the metadata file's source_id column." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:sampleFilenamePos a owl:DatatypeProperty ;
    rdfs:label "positive-mode data file name" ;
    rdfs:domain emi:ExtractSample ; rdfs:range xsd:string ;
    rdfs:comment "Name of the sample's positive-ionization-mode data file, from the metadata file's sample_filename_pos column." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:sampleFilenameNeg a owl:DatatypeProperty ;
    rdfs:label "negative-mode data file name" ;
    rdfs:domain emi:ExtractSample ; rdfs:range xsd:string ;
    rdfs:comment "Name of the sample's negative-ionization-mode data file, from the metadata file's sample_filename_neg column." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:matchScore a owl:DatatypeProperty ;
    rdfs:label "OTT match score" ;
    rdfs:domain emi:Taxon ; rdfs:range xsd:double ;
    rdfs:comment "Score Open Tree of Life's name resolution gave the match (1 for an exact match), on an OTT match node." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:isApproximateMatch a owl:DatatypeProperty ;
    rdfs:label "is approximate OTT match" ;
    rdfs:domain emi:Taxon ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether Open Tree of Life matched the searched name only approximately (fuzzy matching), on an OTT match node." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:isSynonym a owl:DatatypeProperty ;
    rdfs:label "is synonym" ;
    rdfs:domain emi:Taxon ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether the matched name is a synonym of the accepted name of the taxon, on an OTT match node." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:nomenclatureCode a owl:DatatypeProperty ;
    rdfs:label "nomenclature code" ;
    rdfs:domain emi:Taxon ; rdfs:range xsd:string ;
    rdfs:comment "Code of nomenclature governing the matched name, as Open Tree of Life reports it (e.g. ICN, ICZN), on an OTT match node." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:searchString a owl:DatatypeProperty ;
    rdfs:label "OTT search string" ;
    rdfs:domain emi:Taxon ; rdfs:range xsd:string ;
    rdfs:comment "The taxon name submitted to Open Tree of Life's name resolution, on an OTT match node." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:sampleName a owl:DatatypeProperty ;
    rdfs:label "sample name" ;
    rdfs:domain enpkg:SampleMetadata ; rdfs:range xsd:string ;
    rdfs:comment "From the metadata file's sample_name column." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:sampleType a owl:DatatypeProperty ;
    rdfs:label "sample type" ;
    rdfs:domain enpkg:SampleMetadata ; rdfs:range xsd:string ;
    rdfs:comment "Pragmatic plain literal, from the metadata file's sample_type column. Typing the sample by this value instead (emi:QCSample / emi:Blank / emi:ExtractSample) is not implemented: the serializer always types the node emi:ExtractSample. Tracked in docs/DATA_MODEL_AND_SERIALIZATION_GAP.md §D4." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:collectionDate a owl:DatatypeProperty ;
    rdfs:label "collection date" ;
    rdfs:domain enpkg:SampleMetadata ; rdfs:range xsd:date ;
    rdfs:comment "From the metadata file's collection_date column; a date-time value is reduced to its date." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:collectionLocation a owl:DatatypeProperty ;
    rdfs:label "collection location" ;
    rdfs:domain enpkg:SampleMetadata ; rdfs:range xsd:string ;
    rdfs:comment "Free text, from the metadata file's collection_location column." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:extractionMethod a owl:DatatypeProperty ;
    rdfs:label "extraction method" ;
    rdfs:domain emi:ExtractSample ; rdfs:range xsd:string ;
    rdfs:comment "From the metadata file's extraction_method column." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:extractionSolvent a owl:DatatypeProperty ;
    rdfs:label "extraction solvent" ;
    rdfs:domain emi:ExtractSample ; rdfs:range xsd:string ;
    rdfs:comment "From the metadata file's extraction_solvent column." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:operator a owl:DatatypeProperty ;
    rdfs:label "operator" ;
    rdfs:domain emi:LCMSAnalysis ; rdfs:range xsd:string ;
    rdfs:comment "From the metadata file's operator column. The metadata row describes a sample, so the pos and neg runs of one sample carry the same value." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:instrument a owl:DatatypeProperty ;
    rdfs:label "instrument" ;
    rdfs:domain emi:LCMSAnalysis ; rdfs:range xsd:string ;
    rdfs:comment "From the metadata file's instrument column. The metadata row describes a sample, so the pos and neg runs of one sample carry the same value." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:ionizationMode a owl:DatatypeProperty ;
    rdfs:label "ionization mode" ;
    rdfs:domain emi:LCMSAnalysis ; rdfs:range xsd:string ;
    rdfs:comment "'pos' or 'neg', always emitted together with the matching emi:LCMSAnalysisPos / emi:LCMSAnalysisNeg rdf:type. Neither is emitted when the run's ionization mode is not recognised as positive or negative." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:extraMetadataField a owl:DatatypeProperty ;
    rdfs:label "extra metadata field" ;
    rdfs:domain enpkg:ExtraMetadata ;
    rdfs:comment "Super-property of every predicate minted from a metadata-file column header (emi-res:metadatafield/<percent-encoded header>). Each minted predicate is declared in the graph that uses it as an owl:DatatypeProperty, rdfs:subPropertyOf this term, with the column header as its rdfs:label; this term itself is never asserted on a node. No rdfs:range: each value keeps the datatype inferred from the file (xsd:string, xsd:integer, xsd:double, xsd:boolean, xsd:date, xsd:dateTime). Graphs whose files share a column header share its minted predicate, whatever the column means in each." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Adduct / MS1

enpkg:adductMass a owl:DatatypeProperty ;
    rdfs:label "adduct ion m/z" ;
    rdfs:domain enpkg:AdductAnnotation ; rdfs:range xsd:double ;
    skos:closeMatch ms:1003243 ;
    rdfs:comment "Theoretical m/z of the adduct ion: the hypothesis's recipe applied to enpkg:adductNeutralMass, (multimer factor x neutral mass + ingredient masses) / charge. MS:1003243 (adduct ion mass) is the ion's mass; the two agree only for a singly charged ion." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:adductNeutralMass a owl:DatatypeProperty ;
    rdfs:label "adduct neutral mass" ;
    rdfs:domain enpkg:AdductAnnotation ; rdfs:range xsd:double ;
    skos:closeMatch chemrof:monoisotopic_mass ;
    rdfs:comment "Exact mass of the hypothesis's LOTUS molecular-formula group: the neutral mass enpkg:adductMass is computed from. Not a mass back-calculated from the observed precursor m/z." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:charge a owl:DatatypeProperty ;
    rdfs:label "charge state" ;
    rdfs:domain enpkg:AdductRecipe ; rdfs:range xsd:integer ;
    skos:exactMatch ms:1000041 ;
    rdfs:comment "Number of charges the recipe gives the ion (1 for [M+H]+, 2 for [M+2H]2+); its sign is given by enpkg:isPositive." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:isPositive a owl:DatatypeProperty ;
    rdfs:label "is positive" ;
    rdfs:domain enpkg:AdductRecipe ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether the recipe produces a positively charged ion." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:multimerFactor a owl:DatatypeProperty ;
    rdfs:label "multimer factor" ;
    rdfs:domain enpkg:AdductRecipe ; rdfs:range xsd:integer ;
    rdfs:comment "Number of neutral molecules in the ion: 1 for [M+H]+, 2 for [2M+H]+." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:adductFormula a owl:DatatypeProperty ;
    rdfs:label "adduct formula" ;
    rdfs:domain enpkg:AdductRecipe ; rdfs:range xsd:string ;
    skos:exactMatch ms:1002813 ;
    rdfs:comment "The recipe in bracket notation, such as [M+H]+, [M+NH4]+ or [2M+Na]+; the same string emi:hasAdduct carries on the annotations that apply the recipe." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:ingredientName a owl:DatatypeProperty ;
    rdfs:label "ingredient name" ;
    rdfs:domain enpkg:Ingredient ; rdfs:range xsd:string ;
    rdfs:comment "Name of the ingredient, such as proton, sodium or water." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:ingredientCount a owl:DatatypeProperty ;
    rdfs:label "ingredient count" ;
    rdfs:domain enpkg:Ingredient ; rdfs:range xsd:integer ;
    rdfs:comment "Signed number of the ingredient in the recipe: positive when added, negative when lost (water -1 in [M+H-H2O]+)." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:annotationMethod a owl:DatatypeProperty ;
    rdfs:label "annotation method" ;
    rdfs:domain enpkg:AdductAnnotation ; rdfs:range xsd:string ;
    rdfs:comment "How the MS1 hypothesis was produced. 'precursor-mass-search': the feature's precursor m/z fell within the configured ppm tolerance of the theoretical m/z of this formula group under this recipe. 'cluster-anchor-inheritance': the feature is a satellite of an adduct cluster, and the hypothesis is its anchor's candidate molecule re-cast under the satellite's own recipe, without a mass search of the satellite's precursor; its mass agreement rests on the cluster's anchor-satellite relationship." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:clusterConnectivity a owl:DatatypeProperty ;
    rdfs:label "cluster global connectivity" ;
    rdfs:domain enpkg:AdductCluster ; rdfs:range xsd:integer ;
    rdfs:comment "Number of member features in the adduct cluster: mzAdan's cluster global connectivity index (CGC)." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:clusterIntensityCoverage a owl:DatatypeProperty ;
    rdfs:label "cluster intensity coverage" ;
    rdfs:domain enpkg:AdductCluster ; rdfs:range xsd:double ;
    rdfs:comment "Fraction (0 to 1) of the analysis's total feature intensity carried by the cluster's members: mzAdan's cluster intensity coverage index (CIC)." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:clusterCountCoverage a owl:DatatypeProperty ;
    rdfs:label "cluster count coverage" ;
    rdfs:domain enpkg:AdductCluster ; rdfs:range xsd:double ;
    rdfs:comment "Fraction (0 to 1) of the analysis's features that are members of the cluster: mzAdan's cluster count coverage index (CCC)." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:clusterRole a owl:DatatypeProperty ;
    rdfs:label "cluster role" ;
    rdfs:domain emi:LCMSFeature ; rdfs:range xsd:string ;
    rdfs:comment "A feature's role in its adduct cluster: 'anchor' or 'satellite'." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:resolvedAdduct a owl:DatatypeProperty ;
    rdfs:label "resolved adduct" ;
    rdfs:domain emi:LCMSFeature ; rdfs:range xsd:string ;
    rdfs:comment "The ionization form the MS1 adduct-relationship graph assigned to a cluster member, in bracket notation (e.g. [M+Na]+)." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Molecular formula

enpkg:formula a owl:DatatypeProperty ;
    rdfs:label "formula" ;
    rdfs:domain enpkg:MolecularFormula ; rdfs:range xsd:string ;
    rdfs:comment "The formula written in Hill order (carbon, hydrogen, then the other elements alphabetically; strictly alphabetical without carbon), followed by its net charge when not zero: C15H20O6, C11H12NO+, C13H20N2O4P+2." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:netCharge a owl:DatatypeProperty ;
    rdfs:label "net charge" ;
    rdfs:domain enpkg:MolecularFormula ; rdfs:range xsd:integer ;
    rdfs:comment "Net charge of the molecule the formula describes: 0 for a neutral molecule, signed otherwise (+1 for a quaternary ammonium such as C11H12NO+). A property of the molecule itself, not the charge an adduct recipe adds on ionization (enpkg:charge)." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:element a owl:DatatypeProperty ;
    rdfs:label "element" ;
    rdfs:domain enpkg:Atom ; rdfs:range xsd:string ;
    rdfs:comment "Symbol of the chemical element, such as C, H or Se." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:atomCount a owl:DatatypeProperty ;
    rdfs:label "atom count" ;
    rdfs:domain enpkg:Atom ; rdfs:range xsd:positiveInteger ;
    rdfs:comment "Number of atoms of the element in the formula." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

# Reserved for isotope-labelled formulas, which no current source provides; the form of
# its value (mass number or labelled symbol) is decided when one does.
enpkg:isotope a owl:DatatypeProperty ;
    rdfs:label "isotope" ;
    rdfs:domain enpkg:Atom ; rdfs:range xsd:string ;
    rdfs:comment "The isotope an atom node counts, for an isotope-labelled formula. Absent for atoms at natural isotopic abundance." ;
    vs:term_status "unstable" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Annotation ranking and provenance

enpkg:annotationRank a owl:DatatypeProperty ;
    rdfs:label "annotation rank" ;
    rdfs:domain emi:StructuralAnnotation ; rdfs:range xsd:integer ;
    rdfs:comment "Rank of the annotation among the feature's annotations of the same kind, 1 being the best. MS1 and MS2 annotations are ranked by the agreement between the candidate's NPClassifier classification and the classes propagated to the feature (enpkg:annotationScore), MS2 falling back to the spectral score when no propagated classes exist; SIRIUS annotations keep SIRIUS's own rank." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:annotationScore a owl:DatatypeProperty ;
    rdfs:label "annotation score" ;
    rdfs:domain emi:StructuralAnnotation ; rdfs:range xsd:double ;
    rdfs:comment "Score enpkg:annotationRank ranks by, for MS1 and MS2 annotations: the agreement between the candidate's NPClassifier pathway, superclass and class scores and those propagated to the feature, or the MS2 spectral score when no propagated classes exist. Not emitted for SIRIUS annotations." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:nMatchedPeaks a owl:DatatypeProperty ;
    rdfs:label "number of matched peaks" ;
    rdfs:domain enpkg:SpectralAnnotation ; rdfs:range xsd:integer ;
    rdfs:comment "Number of peaks matched between the feature's MS2 spectrum and the library spectrum." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:algorithm a owl:DatatypeProperty ;
    rdfs:label "spectral similarity algorithm" ;
    rdfs:domain enpkg:SpectralAnnotation ; rdfs:range xsd:string ;
    rdfs:comment "Spectral similarity that produced the match's emi:hasSpectralScore: 'cosine_greedy' (matchms CosineGreedy) or 'cosine_hungarian' (matchms CosineHungarian)." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:siriusVersion a owl:DatatypeProperty ;
    rdfs:label "SIRIUS version" ;
    rdfs:domain enpkg:SiriusAnnotation ; rdfs:range xsd:string ;
    rdfs:comment "Version of the SIRIUS application that proposed the candidate, such as 6.3.4. Absent when the version could not be determined." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Molecular network

enpkg:componentSize a owl:DatatypeProperty ;
    rdfs:label "component size" ;
    rdfs:domain emi:FBMNComponent ; rdfs:range xsd:integer ;
    rdfs:comment "Number of member features in the molecular-network component. emi:FBMNComponent declares no properties of its own." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Compound scalars

enpkg:xlogp a owl:DatatypeProperty ;
    rdfs:label "XLogP" ;
    rdfs:domain emi:ChemicalStructure ; rdfs:range xsd:double ;
    rdfs:comment "Predicted octanol-water partition coefficient (XLogP) of the structure, as given by LOTUS." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:stereocentersTotal a owl:DatatypeProperty ;
    rdfs:label "total stereocentres" ;
    rdfs:domain emi:ChemicalStructure ; rdfs:range xsd:integer ;
    rdfs:comment "Number of stereocentres in the structure, as given by LOTUS." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:stereocentersUnspecified a owl:DatatypeProperty ;
    rdfs:label "unspecified stereocentres" ;
    rdfs:domain emi:ChemicalStructure ; rdfs:range xsd:integer ;
    rdfs:comment "Number of the structure's stereocentres whose configuration the structure leaves unspecified, as given by LOTUS." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:manualValidation a owl:DatatypeProperty ;
    rdfs:label "manually validated" ;
    rdfs:domain emi:ChemicalStructure ; rdfs:range xsd:boolean ;
    rdfs:comment "LOTUS's manual-validation flag, taken from the structure-organism-reference record the structure node was emitted from." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:classyfireKingdom a owl:DatatypeProperty ;
    rdfs:label "ClassyFire kingdom" ;
    rdfs:domain emi:ChemicalStructure ; rdfs:range xsd:string ;
    rdfs:comment "Label of the structure's ClassyFire kingdom, as given by LOTUS." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:classyfireSuperclass a owl:DatatypeProperty ;
    rdfs:label "ClassyFire superclass" ;
    rdfs:domain emi:ChemicalStructure ; rdfs:range xsd:string ;
    rdfs:comment "Label of the structure's ClassyFire superclass, as given by LOTUS or by the spectral library that names the structure." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:classyfireClass a owl:DatatypeProperty ;
    rdfs:label "ClassyFire class" ;
    rdfs:domain emi:ChemicalStructure ; rdfs:range xsd:string ;
    rdfs:comment "Label of the structure's ClassyFire class, as given by LOTUS or by the spectral library that names the structure." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:classyfireDirectParent a owl:DatatypeProperty ;
    rdfs:label "ClassyFire direct parent" ;
    rdfs:domain emi:ChemicalStructure ; rdfs:range xsd:string ;
    rdfs:comment "Label of the structure's ClassyFire direct parent, as given by LOTUS." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

### Ions

enpkg:productIonMz a owl:DatatypeProperty ;
    rdfs:label "product ion m/z" ;
    rdfs:domain chebi:24870 ; rdfs:range xsd:double ;
    skos:exactMatch ms:1001225 ;
    rdfs:comment "m/z of one product ion of a feature's MS2 spectrum." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:productIonIntensity a owl:DatatypeProperty ;
    rdfs:label "product ion intensity" ;
    rdfs:domain chebi:24870 ; rdfs:range xsd:double ;
    skos:exactMatch ms:1001226 ;
    rdfs:comment "Intensity of one product ion, on the scale of the feature's MS2 spectrum as the pipeline read it." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:lowIntensityThreshold a owl:DatatypeProperty ;
    rdfs:label "low intensity threshold" ;
    rdfs:domain emi:LCMSFeature ; rdfs:range xsd:double ;
    skos:exactMatch ms:1000629 ;
    rdfs:comment "Minimum intensity a product ion needed to be emitted with enpkg:hasIon, as a fraction (0 to 1) of the spectrum's most intense peak. Present only when that filter was applied." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .

enpkg:maxIonsPerSpectrum a owl:DatatypeProperty ;
    rdfs:label "maximum ions per spectrum" ;
    rdfs:domain emi:LCMSFeature ; rdfs:range xsd:integer ;
    rdfs:comment "Maximum number of product ions emitted with enpkg:hasIon for the feature, the most intense kept. Present only when that cap was applied." ;
    vs:term_status "testing" ;
    rdfs:isDefinedBy <https://w3id.org/enpkg> .
